NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Yalnızca sunucuda. Asla mobil uygulamaya veya tarayıcıya koymayın.
SUPABASE_SECRET_KEY=sb_secret_...
# En az 32 karakter. Değişirse eski takip kodları çalışmaz. Üretmek için: openssl rand -base64 48
TRACKING_CODE_SECRET=
# İsteğe bağlı. Yalnızca güvenilir ters vekilin tek IP ile üzerine yazdığı başlık.
# TRACKING_CLIENT_IP_HEADER=X-Real-IP
# İsteğe bağlı. Yalnızca supabase/migrate.sh --cloud için: Dashboard > Connect > Session pooler.
# SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<şifre>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres
